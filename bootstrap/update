#!/usr/bin/env bash
set -euo pipefail

BOOTSTRAP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "==> Updating all tools..."

# Update Homebrew packages
echo "==> Updating Homebrew..."
brew update
brew upgrade
brew bundle --file="$BOOTSTRAP_DIR/Brewfile"
brew cleanup

# Update all manual tools
echo "==> Updating manual tools..."
for script in "$BOOTSTRAP_DIR/tools/"*; do
    if [[ -x "$script" ]]; then
        echo "==> Updating $(basename "$script")..."
        "$script" update
    fi
done

# Ensure machine-specific git user config exists (~/.gitconfig_user)
# Included by git/.gitconfig but not tracked; generate it if missing.
GITCONFIG_USER="$HOME/.gitconfig_user"
if [[ ! -f "$GITCONFIG_USER" ]]; then
    echo "==> git user config missing, generating..."
    read -rp "    Git user.name: " git_user_name
    read -rp "    Git user.email: " git_user_email
    cat > "$GITCONFIG_USER" <<EOF
[user]
	name = $git_user_name
	email = $git_user_email
EOF
    echo "    Wrote $GITCONFIG_USER"
fi

echo "==> Update complete!"
